{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scholar Investigation Data Schema",
  "description": "Unified data model for academic investigation workflow. All script outputs should conform to this schema before report generation.",
  "type": "object",
  "required": [
    "name",
    "institution",
    "investigation_date",
    "basic_profile",
    "academic_outputs",
    "quality_assessment",
    "relationship_network",
    "anomalies",
    "confidence_ratings",
    "student_reviews"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Scholar name"
    },
    "institution": {
      "type": "string",
      "description": "Current affiliation"
    },
    "investigation_date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD"
    },
    "investigation_type": {
      "type": "string",
      "enum": ["domestic", "international", "cross_border"],
      "description": "调查类型: domestic=国内学者, international=国外导师, cross_border=海归/跨境"
    },
    "basic_profile": {
      "type": "object",
      "required": ["name", "institution", "current_title", "education_background", "career_timeline"],
      "properties": {
        "name": { "type": "string" },
        "institution": { "type": "string" },
        "current_title": { "type": "string", "description": "e.g. 教授, 副教授, 研究员" },
        "academic_title": { "type": "string", "description": "e.g. 博士生导师, 长江学者" },
        "birth_year": { "type": ["integer", "null"] },
        "gender": { "type": "string" },
        "department": { "type": "string" },
        "discipline": { "type": "string", "description": "学科大类: 人文社科/理工科/医学" },
        "education_background": {
          "oneOf": [
            { "type": "string", "description": "[TO BE FILLED] or plain text" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "degree": { "type": "string" },
                  "field": { "type": "string" },
                  "institution": { "type": "string" },
                  "year": { "type": "integer" }
                }
              }
            }
          ]
        },
        "career_timeline": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "year": { "type": "integer" },
                  "event": { "type": "string" },
                  "institution": { "type": "string" }
                }
              }
            }
          ]
        },
        "overseas_experience": { "type": ["string", "null"] }
      }
    },
    "academic_outputs": {
      "type": "object",
      "required": ["claimed_papers", "verified_papers", "claimed_monographs", "verified_monographs", "source_databases", "recent_3yr_papers"],
      "properties": {
        "claimed_papers": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "verified_papers": { "oneOf": [{ "type": "integer" }, { "type": "string", "pattern": "^\\[TO BE FILLED\\]$" }] },
        "claimed_monographs": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "verified_monographs": { "oneOf": [{ "type": "integer" }, { "type": "string", "pattern": "^\\[TO BE FILLED\\]$" }] },
        "source_databases": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "recent_3yr_papers": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "paper_list": { "type": ["string", "array"] },
        "monograph_list": { "type": ["string", "array"] }
      }
    },
    "quality_assessment": {
      "type": "object",
      "properties": {
        "originality_score": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "theoretical_depth": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "journal_quality": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "text_profile_summary": { "type": "object" },
        "style_analysis": { "type": "object" },
        "hybrid_score_summary": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "avg_score": { "type": "number" },
            "max_score": { "type": "number" },
            "min_score": { "type": "number" },
            "rating_distribution": { "type": "object" },
            "top_papers": { "type": "array" },
            "bottom_papers": { "type": "array" }
          }
        }
      }
    },
    "relationship_network": {
      "type": "object",
      "properties": {
        "advisor": { "type": ["string", "object", "null"] },
        "key_collaborators": { "type": ["string", "array", "null"] },
        "editorial_connections": { "type": ["string", "array", "null"] },
        "institutional_dependencies": { "type": ["string", "array", "null"] },
        "citation_analysis": { "type": "object" }
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "evidence_sources": { "type": "array", "items": { "type": "string" } },
          "confidence_level": { "type": "string", "enum": ["L1", "L2", "L3", "L4", "L5"] }
        }
      }
    },
    "confidence_ratings": {
      "type": "object",
      "properties": {
        "basic_profile": { "type": "string", "enum": ["low", "medium", "high", "very_high"] },
        "output_quantity": { "type": "string", "enum": ["low", "medium", "high", "very_high"] },
        "quality_assessment": { "type": "string", "enum": ["low", "medium", "high", "very_high"] },
        "relationship_network": { "type": "string", "enum": ["low", "medium", "high", "very_high"] },
        "anomaly_detection": { "type": "string", "enum": ["low", "medium", "high", "very_high"] },
        "student_reviews": { "type": "string", "enum": ["low", "medium", "high", "very_high"] }
      }
    },
    "student_reviews": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["loaded", "no_report_found", "matched", "unmatched"] },
        "matched": { "type": "boolean" },
        "count": { "type": ["integer", "null"] },
        "average_rating": { "type": ["number", "null"] },
        "average_credibility": { "type": ["number", "null"] },
        "investigation_leads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "mention_count", "severity"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "mention_count": { "type": "integer" },
              "affected_reviews": { "type": "integer" },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "base_severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "severity_reasons": { "type": "array", "items": { "type": "string" } },
              "confidence_level": { "type": "string", "enum": ["L1", "L2", "L3", "L4", "L5"] },
              "verify_action": { "type": "string" },
              "verify_databases": { "type": "array", "items": { "type": "string" } },
              "related_dimensions": { "type": "array", "items": { "type": "string" } },
              "cross_validation": {
                "type": "object",
                "properties": {
                  "negative_dimensions": { "type": "integer" },
                  "total_related": { "type": "integer" },
                  "ratio": { "type": "number" }
                }
              },
              "evidence_quotes": { "type": "array", "items": { "type": "string" } },
              "avg_credibility_of_affected": { "type": "number" }
            }
          }
        },
        "lead_summary": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "severity_distribution": { "type": "object" },
            "confidence_distribution": { "type": "object" }
          }
        },
        "overall_risk_assessment": {
          "type": "object",
          "properties": {
            "level": { "type": "string", "enum": ["critical", "high", "medium", "low", "unknown"] },
            "critical_leads": { "type": "integer" },
            "high_leads": { "type": "integer" },
            "medium_leads": { "type": "integer" },
            "summary": { "type": "string" }
          }
        },
        "cross_dimensional_anomalies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": { "type": "string" },
              "description": { "type": "string" },
              "affected_dimensions": { "type": "array", "items": { "type": "string" } },
              "severity": { "type": "string" }
            }
          }
        },
        "dimension_summary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mention_count": { "type": "integer" },
              "sentiment_distribution": { "type": "object" },
              "dominant_sentiment": { "type": "string" },
              "average_intensity": { "type": "number" },
              "sample_quotes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "radar_data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": { "type": "string" },
              "score": { "type": "number" },
              "max": { "type": "number" },
              "mention_count": { "type": "integer" },
              "dominant_sentiment": { "type": "string" }
            }
          }
        },
        "top_reviews": { "type": "array" },
        "disclaimer": { "type": "string" }
      }
    },
    "funding_verification": {
      "type": "object",
      "properties": {
        "nsfc_portal_searched": { "type": "boolean" },
        "nsfc_active_projects": { "type": ["integer", "null"] },
        "nsfc_last_search_date": { "type": ["string", "null"] },
        "provincial_projects_found": { "type": ["integer", "null"] },
        "corporate_projects_found": { "type": ["integer", "null"] }
      }
    },
    "manual_sources": { "type": "object" },
    "claims": { "type": "object" },
    "investigation_scope": { "type": "object" },
    "script_outputs": {
      "type": "object",
      "properties": {
        "text_profiles": { "type": "array", "items": { "type": "string" } },
        "citation_report": { "type": ["string", "null"] },
        "style_report": { "type": ["string", "null"] },
        "review_matched": { "type": ["string", "null"] },
        "hybrid_score_report": { "type": ["string", "null"] }
      }
    },
    "_builder_notes": { "type": "array", "items": { "type": "string" } }
  }
}
