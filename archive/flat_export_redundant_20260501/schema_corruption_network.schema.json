{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Corruption Network Investigation Data Schema",
  "description": "Multi-node, multi-case corruption network model for institutional misconduct investigations. Supports cross-case person mapping, timeline weaving, and relationship encoding.",
  "type": "object",
  "required": ["network_name", "nodes", "links"],
  "properties": {
    "network_name": { "type": "string" },
    "network_subtitle": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "date": { "type": "string" },
          "type": { "type": "string", "enum": ["criminal_case", "disciplinary_case", "death_event", "academic_misconduct", "other"] },
          "official_source": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "core_subject",
              "protector",
              "accomplice",
              "external",
              "academic",
              "institution",
              "family",
              "victim",
              "official"
            ]
          },
          "case_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "institution": { "type": "string" },
          "role": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "shelter",
              "academic",
              "academic_packaging",
              "money_laundering",
              "project_collab",
              "clinical",
              "accomplice",
              "victimization",
              "family",
              "formal_punishment",
              "affiliated_with"
            ]
          },
          "encoding": {
            "type": "string",
            "description": "Six-letter corruption coding: S→C, D→P, M→W, P→S, C→D, F→S"
          },
          "detail": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 },
          "is_anomaly": { "type": "boolean" }
        }
      }
    },
    "timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "events"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "event"],
              "properties": {
                "date": { "type": "string" },
                "node_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "event": { "type": "string" },
                "category": { "type": "string" },
                "source": { "type": "string" },
                "is_anchor": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grant_id": { "type": "string" },
          "name": { "type": "string" },
          "pi": { "type": "string" },
          "pi_institution": { "type": "string" },
          "period": { "type": "string" },
          "linked_papers": { "type": "array" },
          "linked_events": { "type": "array" }
        }
      }
    },
    "negative_space": {
      "type": "object",
      "properties": {
        "matrix": { "type": "array" },
        "evasion_score": { "type": "number" }
      }
    },
    "node_count": { "type": "integer" },
    "link_count": { "type": "integer" }
  }
}
